{
  "name": "meteogram-card",
  "version": "2026.8.2",
  "description": "A custom card showing a meteogram with wind barbs, cloud cover, atmospheric pressure, and precipitation for Home Assistant",
  "type": "module",
  "main": "dist/meteogram-card.js",
  "scripts": {
    "build": "rollup -c --bundleConfigAsCjs",
    "build:dev": "cross-env ROLLUP_WATCH=true rollup -c --bundleConfigAsCjs",
    "watch": "rollup -c --watch --bundleConfigAsCjs",
    "lint": "eslint src",
    "start": "npm run build && serve",
    "lint:fix": "eslint src --fix",
    "snapshot": "node test/snapshot.mjs",
    "snapshot:capture": "node test/snapshot.mjs --capture",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DTekNO/lovelace-meteogram-card.git"
  },
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "automation",
    "lovelace",
    "custom-cards",
    "weather",
    "meteogram"
  ],
  "author": "Jeremy Cook",
  "license": "MIT",
  "dependencies": {
    "d3": "^7.9.0",
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/d3": "^7.4.3",
    "cross-env": "^7.0.3",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "playwright": "^1.62.1",
    "rollup": "^4.9.5",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
